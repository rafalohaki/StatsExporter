<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.rafalohaki</groupId>
    <artifactId>StatsExporter</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <packaging>jar</packaging>
    <name>StatsExporter</name>
    <description>Exports player vanilla statistics to an external service.</description> <!-- Updated description -->

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <paper.api.version>1.21-R0.1-SNAPSHOT</paper.api.version>
        <gson.version>2.10.1</gson.version>
        <!-- Add OkHttp version property -->
        <okhttp.version>4.12.0</okhttp.version> <!-- Check for latest OkHttp version -->
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- No longer need PlaceholderAPI repo -->
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Gson (for JSON Parsing) - Will be shaded -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
            <scope>compile</scope>
        </dependency>

        <!-- OkHttp (for sending HTTP requests) - Will be shaded -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
            <scope>compile</scope>
        </dependency>
        <!-- Okio (OkHttp dependency) - Will be shaded -->
        <!-- Usually pulled in by okhttp, but explicitly adding helps shade plugin -->
         <dependency>
            <groupId>com.squareup.okio</groupId>
            <artifactId>okio-jvm</artifactId> <!-- For Java 1.8+ -->
            <version>3.9.0</version> <!-- Match version compatible with OkHttp, check Maven Central -->
            <scope>compile</scope>
        </dependency>

        <!-- PlaceholderAPI dependency removed -->
        <!-- CMI dependency removed / not needed -->

    </dependencies>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <plugins>
            <!-- Java Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>

            <!-- Maven Shade Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <relocations>
                                <!-- Relocate Gson -->
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>com.rafalohaki.statsexporter.libs.gson</shadedPattern>
                                </relocation>
                                <!-- Relocate OkHttp -->
                                <relocation>
                                    <pattern>okhttp3</pattern>
                                    <shadedPattern>com.rafalohaki.statsexporter.libs.okhttp3</shadedPattern>
                                </relocation>
                                <!-- Relocate Okio -->
                                <relocation>
                                    <pattern>okio</pattern>
                                    <shadedPattern>com.rafalohaki.statsexporter.libs.okio</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <!-- Optional: Minimize the JAR size -->
                            <!-- <minimizeJar>true</minimizeJar> -->
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <!-- Process plugin.yml variables -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
